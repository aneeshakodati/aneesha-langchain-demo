# Copy to .env and fill in. `.env` is gitignored.

# --- Required ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- LangSmith --------------------------------------------------------------
# Everything runs without these; you just get no traces and no eval experiments.
# These are the current variable names — the older LANGCHAIN_* names no longer work.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=chinook-support

# --- Model overrides (optional) ---------------------------------------------
# All four are read through accessors in config.py at the moment they're used, so
# setting any of them here — or exporting it before a run — actually takes effect.
# Specialists. Reasoning quality matters most here.
# AGENT_MODEL=anthropic:claude-sonnet-5
# Supervisor router and the direct-reply node: one structured-output call per hop,
# so latency and cost dominate.
# ROUTER_MODEL=anthropic:claude-haiku-4-5-20251001
# Conversation summarization once a merch browse session gets long.
# SUMMARY_MODEL=anthropic:claude-haiku-4-5-20251001
# LLM-as-judge in the eval suite.
# JUDGE_MODEL=anthropic:claude-sonnet-5
